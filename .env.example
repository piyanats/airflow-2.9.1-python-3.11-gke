# Airflow User ID for docker-compose
# On Linux, set this to your user ID: $(id -u)
AIRFLOW_UID=50000

# Airflow Web UI credentials
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin

# GCP Configuration (for both local and GKE)
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
GKE_CLUSTER_NAME=airflow-cluster
K8S_NAMESPACE=default

# GCS Configuration
GCS_BUCKET_NAME=your-airflow-bucket

# GCR Configuration
GCR_REGION=us
IMAGE_TAG=2.9.1-python3.11

# PostgreSQL Configuration (for GKE)
POSTGRES_HOST=your-postgresql-host
POSTGRES_PORT=5432
POSTGRES_DB=airflow
POSTGRES_USER=airflow
POSTGRES_PASSWORD=change-this-password

# Git Sync Configuration
GIT_SYNC_REPO=git@github.com:your-org/your-repo.git
GIT_SYNC_BRANCH=main

# Airflow Webserver URL (update for production)
AIRFLOW_BASE_URL=http://localhost:8080
